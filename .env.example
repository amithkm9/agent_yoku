# agent-yoku — copy to `.env` and fill in. Falls back to ~/Desktop/.env.

# JIRA — Atlassian Cloud
JIRA_EMAIL=you@asato.ai
JIRA_TOKEN=
JIRA_BASE_URL=https://asato-ai.atlassian.net
JIRA_PROJECT=AS

# GitHub — PAT with `repo` + `read:org` scopes
GITHUB_TOKEN=
GITHUB_ORG=AsatoCorp
GITHUB_PR_LOOKBACK_DAYS=365

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
CHAT_MODEL_PROVIDER=openai

# ZeroEntropy reranker — optional second-stage reranker over hybrid-search hits.
# Leave the key blank to disable (search falls back to the built-in reranker).
ZEROENTROPY_API_KEY=
RERANK_ENABLED=true
RERANK_MODEL=zerank-2
RERANK_TOP_N=50

# Mongo (each tenant gets its own db: `agent_yoku_<tenant_id>`)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=agent_yoku

# Background auto-sync — refresh every tenant's connectors on an interval.
# Runs the full ingest -> embed -> link pipeline; disable to save OpenAI cost.
AUTO_SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60

# Auth — rotate JWT_SECRET before any non-local deploy
JWT_SECRET=
# Optional dedicated key for connector token encryption (recommended for prod).
# If unset, falls back to a SHA256 derivative of JWT_SECRET.
CONNECTOR_SECRET_KEY=

# Rate limiting (per-process in-memory — add Redis in front for multi-worker hard limits)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Environment — set to "prod" to enforce strong JWT_SECRET at startup
ENV=local

# Observability — optional
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_JSON=false
